<Layouts.app flash={@flash}>
  <header class="max-w-3xl">
    <h1 class="font-serif text-4xl">{@category.name}</h1>
    <p class="mt-3 text-lg text-base-content/70">{@category.blurb}</p>
    <p class="mt-2 text-sm text-base-content/60">
      {length(@prints)} prints shown. Prices on request, in US dollars.
    </p>
  </header>

  <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
    <.print_card :for={print <- @prints} print={print} />
  </div>
</Layouts.app>
