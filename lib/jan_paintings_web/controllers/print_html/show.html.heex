<Layouts.app flash={@flash} current_scope={@current_scope} active={@category.slug}>
  <%!-- Back to this print's place in the list (a full load, so the browser jumps to it). --%>
  <.link
    href={~p"/prints/#{@category.slug}" <> "#print-#{@print.slug}"}
    class="link-more"
  >
    ← {@category.name}
  </.link>

  <div class="mt-6 grid gap-8 md:grid-cols-12 lg:gap-12">
    <div class="min-w-0 md:col-span-7">
      <div class="mat flex items-center justify-center p-4 sm:p-8">
        <%!-- The image itself opens the larger view too. --%>
        <a
          id="print-main-link"
          href={hd(@views).large}
          data-lightbox
          class="cursor-zoom-in"
          title="View larger"
        >
          <img
            id="print-main-image"
            src={JanPaintings.Catalog.image_url(@print.image)}
            alt={"#{@print.artist}, #{@print.title}"}
            class="max-h-[75vh] max-w-full object-contain"
          />
        </a>
      </div>

      <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
        <p :if={@print.gallery != []} class="type-meta">
          {length(@views)} views. Select one to enlarge it above.
        </p>
        <a
          id="print-view-larger"
          href={hd(@views).large}
          data-lightbox
          class="btn btn-sm btn-secondary-rose ml-auto"
        >
          <.icon name="hero-magnifying-glass-plus" class="size-4" /> View larger
        </a>
      </div>

      <%!--
        The larger view opens here, full screen (see app.js). Without JS the
        links above open the image itself.
      --%>
      <dialog
        id="print-lightbox"
        class="print-lightbox"
        aria-label={"#{@print.artist}, #{@print.title}: larger view"}
      >
        <form method="dialog" class="print-lightbox-bar">
          <button id="print-lightbox-close" class="btn btn-primary" autofocus>
            <.icon name="hero-x-mark" class="size-5" /> Close
          </button>
        </form>
        <div class="print-lightbox-stage">
          <img
            id="print-lightbox-image"
            alt={"#{@print.artist}, #{@print.title}"}
            class="print-lightbox-image"
          />
        </div>
      </dialog>

      <div
        :if={@print.gallery != []}
        id="print-gallery"
        class="mt-3 flex gap-2 overflow-x-auto pb-1"
      >
        <a
          :for={{view, index} <- Enum.with_index(@views)}
          href={view.large}
          data-gallery-src={view.src}
          data-gallery-large={view.large}
          aria-current={if index == 0, do: "true", else: "false"}
          aria-label={"View #{index + 1} of #{length(@views)}"}
          class="mat size-16 shrink-0 p-1 opacity-70 transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:outline-2 aria-[current=true]:outline-rose sm:size-20"
        >
          <img src={view.src} alt="" loading="lazy" class="size-full object-contain" />
        </a>
      </div>

      <%!-- From md, the notes sit under the images; on phones they are a row of the details. --%>
      <div :if={@notes != []} id="print-notes" class="mt-6 hidden max-w-[68ch] md:block">
        <p :for={paragraph <- @notes} class="italic text-ink-2 [&+&]:mt-3">{paragraph}</p>
      </div>
    </div>

    <div class="min-w-0 md:col-span-5">
      <.status_badge status={@print.status} class="mb-1" />
      <p class="type-artist print-detail-artist">
        {@print.artist}<span :if={@print.dates != ""}> ({@print.dates})</span>
      </p>
      <h1 class="type-h1 print-detail-title mt-2">{@print.title}</h1>
      <p :if={@print.details != ""} class="mt-6 max-w-[68ch]">{@print.details}</p>

      <dl class="mt-6 border-t border-rule">
        <.detail :if={@print.medium != ""} label="Medium">{@print.medium}</.detail>
        <.detail :if={@print.catalogue_references != ""} label="Catalogue reference">
          {@print.catalogue_references}
        </.detail>
        <.detail :if={@print.watermark != ""} label="Watermark">{@print.watermark}</.detail>
        <.detail :if={@print.provenance != ""} label="Provenance">{@print.provenance}</.detail>
        <.detail :if={@print.condition != ""} label="Condition">{@print.condition}</.detail>
        <.detail :if={@print.dimensions != ""} label="Size">{@print.dimensions}</.detail>
        <.detail :if={@print.sheet_size != ""} label="Sheet">{@print.sheet_size}</.detail>
        <.detail :if={@notes != []} label="Additional notes" class="md:hidden">
          <p :for={paragraph <- @notes} class="italic text-ink-2 [&+&]:mt-3">{paragraph}</p>
        </.detail>
        <.detail label="Price">
          <span :if={@print.status == "sold"} class="text-sold">Sold</span>
          <span :if={@print.status == "reserved"} class="text-sold">Reserved</span>
          <span :if={@print.status == "available"} class="text-xl font-semibold text-ink">
            {if @print.price == "", do: "On request", else: @print.price}
          </span>
        </.detail>
      </dl>

      <.link
        href={~p"/contact?#{[print: @print.slug]}"}
        class="btn btn-primary mt-8 w-full sm:w-auto"
      >
        {if @print.status == "available",
          do: "Request more information",
          else: "Ask about similar prints"}
      </.link>
      <.link
        :if={@more_by_artist?}
        navigate={~p"/prints?#{[q: JanPaintings.Catalog.artist_query(@print)]}"}
        class="btn btn-secondary-rose mt-3 flex w-full sm:w-fit"
      >
        More by this artist
      </.link>
    </div>
  </div>
</Layouts.app>
