<Layouts.app flash={@flash} current_scope={@current_scope} banner={@category.slug}>
  <.link
    navigate={~p"/prints/#{@category.slug}"}
    class="text-sm uppercase tracking-widest text-base-content/60 hover:text-accent"
  >
    <span aria-hidden="true">&larr;</span> {@category.name}
  </.link>

  <div class="mt-6 grid gap-8 md:grid-cols-[3fr_2fr] lg:gap-12">
    <div class="min-w-0">
      <div class="print-mount flex items-center justify-center p-4 sm:p-10">
        <img
          id="print-main-image"
          src={JanPaintings.Catalog.image_url(@print.image)}
          alt={"#{@print.artist}, #{@print.title}"}
          class="max-h-[75vh] max-w-full object-contain shadow"
        />
      </div>

      <div
        :if={@print.large_image != "" or @print.gallery != []}
        class="mt-3 flex flex-wrap items-center justify-between gap-3"
      >
        <p :if={@print.gallery != []} class="text-xs text-base-content/60">
          {length(@views)} views. Select one to enlarge it above.
        </p>
        <a
          id="print-view-larger"
          href={hd(@views).large}
          target="_blank"
          rel="noopener"
          class="ml-auto text-sm text-accent underline underline-offset-4 hover:opacity-70"
        >
          View larger <span aria-hidden="true">&nearr;</span>
        </a>
      </div>

      <div
        :if={@print.gallery != []}
        id="print-gallery"
        class="mt-3 flex gap-2 overflow-x-auto pb-1"
      >
        <a
          :for={{view, index} <- Enum.with_index(@views)}
          href={view.large}
          target="_blank"
          rel="noopener"
          data-gallery-src={view.src}
          data-gallery-large={view.large}
          aria-current={if index == 0, do: "true", else: "false"}
          aria-label={"View #{index + 1} of #{length(@views)}"}
          class="print-mount size-16 shrink-0 p-1 opacity-70 transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-2 aria-[current=true]:ring-accent sm:size-20"
        >
          <img src={view.src} alt="" loading="lazy" class="size-full object-contain" />
        </a>
      </div>
    </div>

    <div class="min-w-0">
      <p class="text-xs uppercase tracking-[0.2em] text-base-content/60">
        {@print.artist}<span :if={@print.dates != ""}> ({@print.dates})</span>
      </p>
      <h1 class="mt-2 font-serif text-2xl leading-snug sm:text-3xl">{@print.title}</h1>
      <a
        :if={@more_by_artist != []}
        href="#more-by-artist"
        class="mt-2 inline-block text-sm text-accent underline underline-offset-4 hover:opacity-70"
      >
        More by this artist ({length(@more_by_artist)})
      </a>
      <.status_badge status={@print.status} class="mt-3" />
      <p :if={@print.details != ""} class="mt-4 leading-relaxed text-base-content/80">
        {@print.details}
      </p>

      <dl class="mt-6 space-y-4 border-t border-base-300 pt-6 text-sm leading-relaxed">
        <.detail :if={@print.medium != ""} label="Medium">{@print.medium}</.detail>
        <.detail :if={@print.catalogue_references != ""} label="References">
          {@print.catalogue_references}
        </.detail>
        <.detail :if={@print.state != ""} label="State">{@print.state}</.detail>
        <.detail :if={@print.dimensions != ""} label="Size">{@print.dimensions}</.detail>
        <.detail :if={@print.sheet_size != ""} label="Sheet">{@print.sheet_size}</.detail>
        <.detail :if={@print.condition != ""} label="Condition">{@print.condition}</.detail>
        <.detail :if={@print.provenance != ""} label="Provenance">{@print.provenance}</.detail>
        <.detail :if={@print.watermark != ""} label="Watermark">{@print.watermark}</.detail>
        <.detail label="Price">
          <span :if={@print.status == "sold"}>Sold</span>
          <span :if={@print.status == "reserved"}>Reserved</span>
          <span :if={@print.status == "available"} class="font-medium text-base-content">
            {if @print.price == "", do: "On request", else: @print.price}
          </span>
        </.detail>
      </dl>

      <.link
        href={~p"/about?#{[print: @print.slug]}" <> "#contact"}
        class="btn btn-primary mt-8 w-full sm:w-auto"
      >
        {if @print.status == "available",
          do: "Enquire about this print",
          else: "Ask about similar prints"}
      </.link>
    </div>
  </div>

  <section
    :if={@more_by_artist != []}
    id="more-by-artist"
    class="mt-16 scroll-mt-6 border-t border-base-300 pt-10"
  >
    <h2 class="font-serif text-2xl">More by this artist</h2>
    <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-8 md:grid-cols-3 lg:grid-cols-4">
      <.print_card :for={print <- @more_by_artist} print={print} />
    </div>
  </section>
</Layouts.app>
