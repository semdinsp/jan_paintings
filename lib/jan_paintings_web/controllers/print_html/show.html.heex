<Layouts.app flash={@flash} banner={@category.slug}>
  <.link
    navigate={~p"/prints/#{@category.slug}"}
    class="text-sm uppercase tracking-widest text-base-content/60 hover:text-accent"
  >
    <span aria-hidden="true">&larr;</span> {@category.name}
  </.link>

  <div class="mt-6 grid gap-8 md:grid-cols-[3fr_2fr] lg:gap-12">
    <div class="print-mount flex items-center justify-center p-4 sm:p-10">
      <img
        src={JanPaintings.Catalog.image_url(@print.image)}
        alt={"#{@print.artist}, #{@print.title}"}
        class="max-h-[75vh] max-w-full object-contain shadow"
      />
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-base-content/60">
        {@print.artist}<span :if={@print.dates != ""}> ({@print.dates})</span>
      </p>
      <h1 class="mt-2 font-serif text-2xl leading-snug sm:text-3xl">{@print.title}</h1>
      <.status_badge status={@print.status} class="mt-3" />
      <p :if={@print.details != ""} class="mt-4 leading-relaxed text-base-content/80">
        {@print.details}
      </p>

      <dl class="mt-6 space-y-4 border-t border-base-300 pt-6 text-sm leading-relaxed">
        <.detail :if={@print.dimensions != ""} label="Size">{@print.dimensions}</.detail>
        <.detail :if={@print.condition != ""} label="Condition">{@print.condition}</.detail>
        <.detail :if={@print.provenance != ""} label="Provenance">{@print.provenance}</.detail>
        <.detail :if={@print.watermark != ""} label="Watermark">{@print.watermark}</.detail>
        <.detail label="Price">
          <span :if={@print.status == "sold"}>Sold</span>
          <span :if={@print.status == "reserved"}>Reserved</span>
          <span :if={@print.status == "available"} class="font-medium text-base-content">
            {if @print.price == "", do: "On request", else: @print.price}
          </span>
        </.detail>
      </dl>

      <.link
        href={~p"/about?#{[print: @print.slug]}" <> "#contact"}
        class="btn btn-primary mt-8 w-full sm:w-auto"
      >
        {if @print.status == "available",
          do: "Enquire about this print",
          else: "Ask about similar prints"}
      </.link>
    </div>
  </div>
</Layouts.app>
