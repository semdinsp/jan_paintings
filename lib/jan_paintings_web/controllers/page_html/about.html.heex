<Layouts.app flash={@flash} current_scope={@current_scope} active="about">
  <div class="lg:grid lg:grid-cols-[minmax(0,68ch)_1fr] lg:gap-16">
    <article class="max-w-[68ch] space-y-6">
      <h1 class="type-h1">About Us</h1>
      <p>
        Jan Johnson founded the business in London in 1979, after six years in the print
        department of P &amp; D Colnaghi and several years of print research in European museum
        collections. It began with Old Master prints. After the move to Montreal in 1982 it took in
        nineteenth- and early twentieth-century European prints and Canadian printmaking as well.
      </p>
      <p>
        Major names are usually in stock, but so are many less familiar artists, which keeps the
        price range wide. Collectors at every level are welcome. Only part of the stock appears
        online, so if you have a particular interest, ask for a focused list.
      </p>
      <p>
        Other services include bidding at auction on behalf of clients and appraisals. Stock can be
        viewed by appointment at the gallery near Montreal.
      </p>
      <p>
        Jan Johnson has taken part in international print fairs for many years and is a founding
        member of the International Fine Print Dealers Association. Clients include museums such as
        the British Museum, the Rijksmuseum, the Metropolitan Museum of Art, the National Gallery of
        Art in Washington, the National Gallery of Canada and the Art Gallery of Ontario.
      </p>
    </article>

    <%!-- Beside the text from lg; below it, at a modest size, on phones and tablets. --%>
    <figure id="about-portrait" class="mt-10 max-w-xs lg:mt-0 lg:max-w-none">
      <div class="mat flex items-center justify-center p-4 lg:p-8">
        <img
          src={~p"/images/jan-johnson.jpg"}
          alt="Portrait of Jan Johnson"
          width="875"
          height="1200"
          class="max-h-[32rem] w-auto max-w-full object-contain"
        />
      </div>
      <figcaption class="mt-3">
        <span class="type-artist block">Jan Johnson</span>
      </figcaption>
    </figure>
  </div>

  <div
    id="contact"
    class="mt-12 grid scroll-mt-16 gap-12 border-t border-rule pt-12 md:mt-16 lg:grid-cols-[2fr_3fr] lg:gap-16"
  >
    <section>
      <h2 class="type-h2">Contact</h2>
      <p class="mt-4">
        To ask about a print, request a stock list or book a viewing, send a message or get in
        touch directly. Prices are in US dollars, and Canadian prints in Canadian dollars.
      </p>
      <.contact_details class="mt-8" />
    </section>

    <section class="bg-paper-2 p-6 sm:p-8">
      <h2 class="type-h2">Send a message</h2>
      <p class="type-meta mt-1">
        We'll reply by email, usually within a few days.
      </p>

      <.form for={@form} action={~p"/about" <> "#contact"} id="contact-form" class="mt-6">
        <div class="grid gap-x-4 sm:grid-cols-2">
          <.input field={@form[:name]} label="Name" autocomplete="name" required />
          <.input field={@form[:email]} type="email" label="Email" autocomplete="email" required />
        </div>
        <div class="grid gap-x-4 sm:grid-cols-2">
          <.input field={@form[:phone]} type="tel" label="Phone (optional)" autocomplete="tel" />
          <.input field={@form[:subject]} label="Subject (optional)" />
        </div>
        <.input field={@form[:message]} type="textarea" label="Message" rows="6" required />
        <.input field={@form[:print_slug]} type="hidden" />

        <%!-- Spam trap: hidden from people, often filled in by bots. --%>
        <div class="hidden" aria-hidden="true">
          <label>
            Leave this empty
            <input
              type="text"
              name="contact_message[website]"
              value=""
              tabindex="-1"
              autocomplete="off"
            />
          </label>
        </div>

        <button type="submit" class="btn btn-primary mt-2 w-full sm:w-auto">Send message</button>
      </.form>
    </section>
  </div>
</Layouts.app>
