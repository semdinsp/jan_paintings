<Layouts.app flash={@flash} current_scope={@current_scope} active="about">
  <div class="lg:grid lg:grid-cols-[minmax(0,68ch)_1fr] lg:gap-16">
    <article class="max-w-[68ch] space-y-6">
      <h1 class="type-h1">About Us</h1>
      <p>
        Jan Johnson, Old Master &amp; Modern Prints, Inc. was founded in 1979 by its owner and
        director, Jan Johnson, after six years in the print department of P &amp; D Colnaghi, London,
        and three years of print research in European museum collections. The company began with Old
        Master prints, and on moving from London to Montreal in 1982 it expanded into nineteenth- and
        early twentieth-century European and Canadian prints.
      </p>
      <p>
        We offer a wide-ranging, well-researched stock, with an emphasis on fine impressions in
        excellent condition. Major names are usually represented, but our taste also runs to the less
        obvious. That variety lets us offer a wide range of prices and welcome collectors at every
        level.
      </p>
      <p>
        This website shows only part of our stock, so please tell us about your interests and we will
        send you a focused list. You can <a href="mailto:jan@janjohnsonprints.com" class="link">email us</a>,
        or <.link href={~p"/about" <> "#mailing-list"} class="link">join our mailing list</.link>
        below.
      </p>
      <p>
        Other services include bidding at auction on behalf of clients and appraisals. Visitors are
        welcome to view the stock by appointment at our premises near Montreal.
      </p>
      <p>
        We have taken part in international print fairs for many years and were a founding member of
        the International Fine Print Dealers Association. Our clients include many of the great
        museums of Europe and North America.
      </p>
    </article>

    <%!-- Beside the text from lg; below it, at a modest size, on phones and tablets. --%>
    <figure id="about-portrait" class="mt-10 max-w-xs lg:mt-0 lg:max-w-none">
      <div class="mat flex items-center justify-center p-4 lg:p-8">
        <img
          src={~p"/images/jan-johnson.jpg"}
          alt="Portrait of Jan Johnson"
          width="875"
          height="1200"
          class="max-h-[32rem] w-auto max-w-full object-contain"
        />
      </div>
      <figcaption class="mt-3">
        <span class="type-artist block">Jan Johnson</span>
      </figcaption>
    </figure>
  </div>

  <section id="about-clients" class="mt-12 border-t border-rule pt-12 md:mt-16">
    <h2 class="type-h2">Museum clients</h2>
    <p class="mt-3 max-w-[68ch] text-ink-2">
      Among the museums and collections we have supplied:
    </p>
    <%!-- The first three, then the rest behind the button below (app.js). --%>
    <ul
      id="about-clients-list"
      data-collapsed
      class="mt-6 grid gap-x-12 text-[0.9375rem] sm:grid-cols-2 lg:grid-cols-3 [&>li]:py-1.5"
    >
      <li>Agnes Etherington Art Centre, Queen's University, Kingston</li>
      <li>Art Gallery of Ontario</li>
      <li>Art Institute of Chicago</li>
      <li class="client-more">Baltimore Museum of Art</li>
      <li class="client-more">Blanton Museum of Art, University of Texas at Austin</li>
      <li class="client-more">British Museum</li>
      <li class="client-more">Cantor Center for Visual Arts, Stanford University</li>
      <li class="client-more">Carleton University Art Gallery, Ottawa</li>
      <li class="client-more">Chazen Museum of Art, University of Wisconsin–Madison</li>
      <li class="client-more">Cleveland Museum of Art</li>
      <li class="client-more">Detroit Institute of Arts</li>
      <li class="client-more">Fine Arts Museums of San Francisco</li>
      <li class="client-more">Fondation Custodia, Paris</li>
      <li class="client-more">Grunwald Center for the Graphic Arts, UCLA</li>
      <li class="client-more">Harvard Art Museums</li>
      <li class="client-more">Hood Museum of Art, Dartmouth</li>
      <li class="client-more">J. Paul Getty Museum</li>
      <li class="client-more">Los Angeles County Museum of Art</li>
      <li class="client-more">McMaster Museum of Art, Hamilton</li>
      <li class="client-more">Metropolitan Museum of Art</li>
      <li class="client-more">Michael C. Carlos Museum, Emory University, Atlanta</li>
      <li class="client-more">Minneapolis Institute of Art</li>
      <li class="client-more">Musée des beaux-arts de Montréal</li>
      <li class="client-more">Musée national des beaux-arts du Québec</li>
      <li class="client-more">Museum of Fine Arts, Boston</li>
      <li class="client-more">National Gallery of Art, Washington</li>
      <li class="client-more">National Gallery of Canada, Ottawa</li>
      <li class="client-more">New York Public Library</li>
      <li class="client-more">Philadelphia Museum of Art</li>
      <li class="client-more">Portland Art Museum</li>
      <li class="client-more">Princeton University Art Museum</li>
      <li class="client-more">Rhode Island School of Design Museum</li>
      <li class="client-more">Rijksmuseum, Amsterdam</li>
      <li class="client-more">Saint Louis Art Museum</li>
      <li class="client-more">Sarah Campbell Blaffer Foundation, Houston</li>
      <li class="client-more">Snite Research Center, University of Notre Dame</li>
      <li class="client-more">Speed Art Museum, Louisville</li>
      <li class="client-more">Spencer Museum of Art, University of Kansas</li>
      <li class="client-more">University of San Diego</li>
      <li class="client-more">Vassar College, Poughkeepsie</li>
      <li class="client-more">Worcester Art Museum</li>
      <li class="client-more">Yale University Art Gallery</li>
      <li class="client-more">Zimmerli Art Museum, Rutgers University, New Jersey</li>
    </ul>
    <button
      type="button"
      id="about-clients-toggle"
      class="btn btn-sm btn-secondary-rose mt-4"
      aria-controls="about-clients-list"
      aria-expanded="false"
    >
      <span class="clients-show">Show all 43 museums</span>
      <span class="clients-hide">Show fewer</span>
      <.icon name="hero-chevron-down" class="clients-chevron size-4" />
    </button>
  </section>

  <div
    id="contact"
    class="mt-12 grid scroll-mt-16 gap-12 border-t border-rule pt-12 md:mt-16 lg:grid-cols-[2fr_3fr] lg:gap-16"
  >
    <section>
      <h2 class="type-h2">Contact</h2>
      <p class="mt-4">
        To ask about a print, request a stock list or book a viewing, send a message or get in
        touch directly. Prices are in US dollars, and Canadian prints in Canadian dollars.
      </p>
      <.contact_details class="mt-8" />
    </section>

    <div class="space-y-8">
      <section class="bg-paper-2 p-6 sm:p-8">
        <h2 class="type-h2">Send a message</h2>
        <p class="type-meta mt-1">
          We'll reply by email, usually within a few days.
        </p>

        <.form for={@form} action={~p"/about" <> "#contact"} id="contact-form" class="mt-6">
          <div class="grid gap-x-4 sm:grid-cols-2">
            <.input field={@form[:name]} label="Name" autocomplete="name" required />
            <.input
              field={@form[:email]}
              type="email"
              label="Email"
              autocomplete="email"
              required
            />
          </div>
          <div class="grid gap-x-4 sm:grid-cols-2">
            <.input field={@form[:phone]} type="tel" label="Phone (optional)" autocomplete="tel" />
            <.input field={@form[:subject]} label="Subject (optional)" />
          </div>
          <.input field={@form[:message]} type="textarea" label="Message" rows="6" required />
          <.input field={@form[:print_slug]} type="hidden" />

          <%!-- Spam trap: hidden from people, often filled in by bots. --%>
          <div class="hidden" aria-hidden="true">
            <label>
              Leave this empty
              <input
                type="text"
                name="contact_message[website]"
                value=""
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>

          <button type="submit" class="btn btn-primary mt-2 w-full sm:w-auto">Send message</button>
        </.form>
      </section>

      <section id="mailing-list" class="scroll-mt-16 bg-paper-2 p-6 sm:p-8">
        <h2 class="type-h2">Join our mailing list</h2>
        <p class="type-meta mt-1">
          Hear about new stock and print fairs. Tell us what you collect and we'll send lists to match.
        </p>

        <.form
          for={@subscriber_form}
          action={~p"/mailing-list"}
          id="mailing-list-form"
          class="mt-6"
        >
          <div class="grid gap-x-4 sm:grid-cols-2">
            <.input
              field={@subscriber_form[:email]}
              type="email"
              label="Email"
              autocomplete="email"
              required
            />
            <.input field={@subscriber_form[:name]} label="Name (optional)" autocomplete="name" />
          </div>
          <.input
            field={@subscriber_form[:interests]}
            label="Interests (optional)"
            placeholder="e.g. Rembrandt etchings"
          />

          <%!-- Spam trap: hidden from people, often filled in by bots. --%>
          <div class="hidden" aria-hidden="true">
            <label>
              Leave this empty
              <input
                type="text"
                name="subscriber[website]"
                value=""
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>

          <button type="submit" class="btn btn-primary mt-2 w-full sm:w-auto">
            Join the mailing list
          </button>
        </.form>
      </section>
    </div>
  </div>
</Layouts.app>
