<Layouts.app flash={@flash} current_scope={@current_scope}>
  <article id="terms" class="max-w-[68ch]">
    <h1 class="type-h1">Terms of Sale</h1>
    <p class="mt-2 text-ink-2">
      For prints bought from Jan Johnson, Old Master &amp; Modern Prints Inc.
    </p>

    <.terms_of_sale class="mt-7" />

    <p class="mt-10 border-t border-rule pt-5 text-[1rem]">
      Questions about a purchase? <.link href={~p"/contact"} class="link">Contact us</.link>
    </p>
  </article>
</Layouts.app>
