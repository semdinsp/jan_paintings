<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="grid items-center gap-12 md:grid-cols-12 md:gap-8 lg:gap-12">
    <div class="md:col-span-5">
      <p class="type-eyebrow">Fine prints since 1979</p>
      <h1 class="type-display mt-3">
        Old Master, Modern and Canadian prints for collectors and museums.
      </h1>
      <p class="mt-6 max-w-[68ch] text-ink-2">
        A carefully researched stock with an emphasis on fine impressions and good condition.
        Browse a selection below, or get in touch to ask about holdings not shown here.
      </p>
      <div class="mt-8">
        {live_render(@conn, JanPaintingsWeb.SearchLive, id: "home-search-live")}
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <.link navigate={~p"/prints"} class="btn btn-primary">Browse the stock</.link>
        <.link href={~p"/about" <> "#contact"} class="btn btn-secondary-rose">Get in touch</.link>
      </div>
    </div>
    <figure :if={@hero} class="md:col-span-7">
      <.link
        navigate={~p"/prints/#{@hero.category}/#{@hero.slug}"}
        class="mat flex items-center justify-center p-8"
      >
        <img
          src={JanPaintings.Catalog.image_url(@hero.image)}
          alt={"#{@hero.artist}, #{@hero.title}"}
          class="max-h-[28rem] max-w-full object-contain"
        />
      </.link>
      <figcaption class="mt-3">
        <span class="type-artist block">{@hero.artist}</span>
        <span class="font-serif text-lg italic">{@hero.title}</span>
      </figcaption>
    </figure>
  </section>

  <section class="mt-12 grid items-center gap-8 md:mt-16 md:grid-cols-12 md:gap-12">
    <img
      src={JanPaintings.Catalog.image_url("/images/catalogue/jan-green-jacket.jpg")}
      alt="Jan Johnson"
      loading="lazy"
      class="aspect-[4/5] w-full max-w-60 object-cover md:col-span-4 md:max-w-none"
    />
    <div class="md:col-span-8">
      <p class="type-eyebrow">About the gallery</p>
      <h2 class="type-h2 mt-2">Jan Johnson</h2>
      <p class="mt-4 max-w-[68ch]">
        Jan Johnson trained in the print department of P &amp; D Colnaghi in London and opened
        the gallery there in 1979, before moving it to Montreal in 1982. Over four decades the
        gallery has supplied collectors and many of the world's major museums, and helped found
        the International Fine Print Dealers Association. Visitors are welcome to view the stock
        by appointment in Chambly, just outside Montreal.
      </p>
      <.link navigate={~p"/about"} class="link-more mt-4 inline-block">
        More about the gallery →
      </.link>
    </div>
  </section>

  <section class="mt-12 grid gap-6 md:mt-16 md:grid-cols-3">
    <.link
      :for={category <- @categories}
      navigate={~p"/prints/#{category.slug}"}
      class="group flex flex-col bg-paper-2 p-6"
    >
      <h2 class="font-serif text-[1.375rem] leading-snug text-ink">{category.name}</h2>
      <p class="mt-2 flex-1 text-[0.9375rem] text-ink-2">{category.blurb}</p>
      <p class="link-more mt-4 group-hover:text-rose-2 group-hover:underline">Browse →</p>
    </.link>
  </section>

  <section class="mt-12 md:mt-16">
    <h2 class="type-h2 border-b border-rule pb-3">From the stock</h2>
    <div class="print-grid mt-8">
      <.print_card :for={print <- @featured} print={print} />
    </div>
  </section>
</Layouts.app>
