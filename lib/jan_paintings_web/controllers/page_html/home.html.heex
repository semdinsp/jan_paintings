<Layouts.app flash={@flash}>
  <section class="max-w-3xl">
    <p class="text-xs uppercase tracking-[0.25em] text-base-content/60">Fine prints since 1979</p>
    <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">
      Old Master, Modern and Canadian prints for collectors and museums.
    </h1>
    <p class="mt-6 text-lg text-base-content/70">
      A carefully researched stock with an emphasis on fine impressions and good condition.
      Browse a selection below, or get in touch to ask about holdings not shown here.
    </p>
  </section>

  <section class="mt-16 grid gap-8 md:grid-cols-3">
    <.link
      :for={category <- @categories}
      navigate={~p"/prints/#{category.slug}"}
      class="group border border-base-300 p-6 transition hover:border-primary"
    >
      <h2 class="font-serif text-2xl group-hover:text-primary">{category.name}</h2>
      <p class="mt-2 text-sm text-base-content/70">{category.blurb}</p>
      <p class="mt-4 text-xs uppercase tracking-widest text-primary">
        Browse <span aria-hidden="true">&rarr;</span>
      </p>
    </.link>
  </section>

  <section class="mt-20">
    <h2 class="font-serif text-2xl">From the stock</h2>
    <div class="mt-8 grid gap-10 sm:grid-cols-2 md:grid-cols-3">
      <.print_card :for={print <- @featured} print={print} />
    </div>
  </section>
</Layouts.app>
