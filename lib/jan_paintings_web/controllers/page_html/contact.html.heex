<Layouts.app flash={@flash}>
  <section class="max-w-2xl space-y-6">
    <h1 class="font-serif text-4xl">Contact</h1>
    <p class="text-lg text-base-content/80">
      To ask about a print, request a stock list or book a viewing, email or call.
      All prices are quoted in US dollars.
    </p>
    <dl class="grid gap-4 sm:grid-cols-[8rem_1fr]">
      <dt class="text-xs uppercase tracking-widest text-base-content/60">Email</dt>
      <dd>
        <a
          href="mailto:jan@janjohnsonprints.com"
          class="text-accent underline underline-offset-4"
        >
          jan@janjohnsonprints.com
        </a>
      </dd>
      <dt class="text-xs uppercase tracking-widest text-base-content/60">Phone</dt>
      <dd>450.658.2752</dd>
      <dt class="text-xs uppercase tracking-widest text-base-content/60">Fax</dt>
      <dd>450.658.7654</dd>
      <dt class="text-xs uppercase tracking-widest text-base-content/60">Address</dt>
      <dd>189 rue Saint-Pierre<br />Chambly, QC, Canada J3L 1L8</dd>
    </dl>
  </section>
</Layouts.app>
