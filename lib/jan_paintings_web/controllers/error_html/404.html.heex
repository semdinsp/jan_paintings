<Layouts.app flash={%{}}>
  <section id="not-found" class="max-w-[68ch] space-y-6 py-6">
    <h1 class="type-h1">Page not found</h1>
    <p>
      The page you were looking for isn't here. The print may have been sold or moved, or the link
      may be out of date.
    </p>
    <ul class="space-y-2">
      <li><.link navigate={~p"/prints"} class="link">Browse all prints</.link></li>
      <li><.link navigate={~p"/"} class="link">Go to the home page</.link></li>
      <li><.link navigate={~p"/contact"} class="link">Contact us</.link> about a print</li>
    </ul>
  </section>
</Layouts.app>
