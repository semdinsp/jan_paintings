<Layouts.app flash={%{}}>
  <section id="server-error" class="max-w-[68ch] space-y-6 py-6">
    <h1 class="type-h1">Something went wrong</h1>
    <p>
      Sorry, this page couldn't be shown. Please try again in a moment, or
      <a href="mailto:jan@janjohnsonprints.com" class="link">email us</a>
      if the problem continues.
    </p>
    <p><.link navigate={~p"/"} class="link">Go to the home page</.link></p>
  </section>
</Layouts.app>
