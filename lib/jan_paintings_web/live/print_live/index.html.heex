<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  active={(@category && @category.slug) || "prints"}
>
  <header class="border-b border-rule pb-6">
    <h1 class="type-h1">
      {(@category && @category.name) || "All Prints"}
    </h1>
    <p class="mt-3 max-w-[68ch] text-ink-2">
      {(@category && @category.blurb) ||
        "A selection from the stock across Old Master, Modern and Canadian prints."}
    </p>
    <%!-- Only on /prints, where the menu search and More by this artist land. --%>
    <.search_form
      :if={!@category}
      value={@query}
      class="mt-6 max-w-xl"
      phx-change="search"
      phx-submit="search"
    />
    <.nationality_filter
      current={@category}
      query={@query}
      nationality={@nationality}
      options={@nationalities}
      class="mt-4"
    />
    <p class="type-meta mt-4">
      <%= if @query != "" do %>
        {length(@prints)} {if length(@prints) == 1, do: "print", else: "prints"} matching
        “<span class="font-medium text-ink">{@query}</span>”.
        <.link
          patch={@clear_search_path}
          class="link ml-1"
        >
          Clear search
        </.link>
      <% else %>
        {length(@prints)} prints shown.
      <% end %>
    </p>
  </header>

  <div
    :if={@prints == []}
    class="mx-auto mt-12 max-w-md text-center text-ink-2"
  >
    <p class="font-serif text-xl text-ink">No prints found</p>
    <p class="mt-2">
      Try a different spelling, just the artist's surname, or <.link
        patch={~p"/prints?#{[q: @query]}"}
        class="link"
      >
        search all categories</.link>.
      Only part of the stock is online, so
      <.link
        href={~p"/contact"}
        class="link"
      >ask us</.link>
      about anything you don't see.
    </p>
  </div>

  <div
    id="print-results"
    class="print-grid mt-12"
  >
    <.print_card :for={print <- @prints} print={print} />
  </div>
</Layouts.app>
