<Layouts.app flash={@flash} current_scope={@current_scope} banner={@category && @category.slug}>
  <header class="border-b border-base-300 pb-6">
    <h1 class="font-serif text-3xl sm:text-4xl">
      {(@category && @category.name) || "All Prints"}
    </h1>
    <p class="mt-3 max-w-3xl text-base text-base-content/70 sm:text-lg">
      {(@category && @category.blurb) ||
        "A selection from the stock across Old Master, Modern and Canadian prints."}
    </p>
    <.search_form
      value={@query}
      class="mt-6 max-w-xl"
      phx-change="search"
      phx-submit="search"
    />
    <div class="mt-4"><.category_filter current={@category} query={@query} /></div>
    <p class="mt-4 text-sm text-base-content/60">
      <%= if @query != "" do %>
        {length(@prints)} {if length(@prints) == 1, do: "print", else: "prints"} matching
        “<span class="font-medium text-base-content">{@query}</span>”.
        <.link
          patch={if @category, do: ~p"/prints/#{@category.slug}", else: ~p"/prints"}
          class="ml-1 text-accent underline underline-offset-4"
        >
          Clear search
        </.link>
      <% else %>
        {length(@prints)} prints shown.
      <% end %>
    </p>
  </header>

  <div
    :if={@prints == []}
    class="mx-auto mt-12 max-w-md text-center text-base-content/70"
  >
    <p class="font-serif text-xl text-base-content">No prints found</p>
    <p class="mt-2">
      Try a different spelling, just the artist's surname, or <.link
        patch={~p"/prints?#{[q: @query]}"}
        class="text-accent underline underline-offset-4"
      >
        search all categories</.link>.
      Only part of the stock is online, so
      <.link
        href={~p"/about" <> "#contact"}
        class="text-accent underline underline-offset-4"
      >ask us</.link>
      about anything you don't see.
    </p>
  </div>

  <div
    id="print-results"
    class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-8 md:grid-cols-3 lg:grid-cols-4"
  >
    <.print_card :for={print <- @prints} print={print} />
  </div>
</Layouts.app>
